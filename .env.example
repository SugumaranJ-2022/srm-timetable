# ==============================================================================
# SRM Smart AI Timetable ERP — Environment Configuration Template
# ==============================================================================

# Mode: development | testing | production
ENVIRONMENT=development

# JWT & Crypto Secret (MUST be changed in production: minimum 32 chars)
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
MFA_TOKEN_EXPIRE_MINUTES=5
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
OTP_EXPIRE_MINUTES=5

# Rate Limiting & Abuse Prevention
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=300
LOCKOUT_DURATION_SECONDS=900

# Multi-Factor Authentication
MFA_ISSUER=SRM Smart Timetable ERP

# Database Connection (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./timetable.db
# Production Example:
# DATABASE_URL=postgresql+asyncpg://srm_user:secure_password@localhost:5432/srm_timetable

# Email Service Configuration
# In development, EMAIL_PROVIDER=mock records messages in memory for inspection.
# In production, set to 'smtp' and provide legitimate credentials.
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_verified_account@srm.edu
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=noreply@srm.edu
SMTP_USE_TLS=true

# SMS Service Configuration
# In development, SMS_PROVIDER=mock records messages in memory for inspection.
# In production, set to 'twilio' and provide verified account credentials.
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+15551234567

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
